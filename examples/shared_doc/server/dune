; The server tier is a library so the test suite links the very handler the
; binary serves (see shared_doc_serve.ml); [main] is only the entry point.
(library
 (name shared_doc_serve)
 (modules shared_doc_serve)
 ; tea_core, tea_rpc, repr, tea_persist_pack and irmin are explicit under
 ; (implicit_transitive_deps false): the App/RPC/store functor signatures are
 ; spelled in their types ([Pack.Server.Store] is a [Store_pack.Make] result
 ; whose [S] carries irmin module types). Signature visibility only: the
 ; sink gate still refuses any [Irmin*] token in this library's source.
 (libraries tea_core tea_rpc repr tea_persist tea_persist_pack irmin
   tea_server tea_server_pack shared_doc_app dream lwt))

; main.ml is sink-free since step 23 (the mem arm delegates to Server.serve
; with the rpc_once builder), so the entry point no longer links dream.
; tea_persist_pack is signature visibility only: [Tea_server_pack.Root] is
; an alias into [Tea_persist_pack.Store_pack].
(executable
 (name main)
 (modules main)
 (libraries shared_doc_serve tea_server tea_server_pack tea_persist_pack
   shared_doc_app))
